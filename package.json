{
  "name": "folio-pdf-tauri",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/tauri.mjs dev",
    "dev:web": "node scripts/frontend.mjs dev",
    "build": "tsc --noEmit && node scripts/frontend.mjs build",
    "build:desktop": "node scripts/tauri.mjs build --no-bundle -- --locked",
    "dist:win": "node scripts/tauri.mjs build --bundles nsis -- --locked",
    "test": "node --test tests/*.test.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "test:native": "node scripts/native-smoke.mjs",
    "check:rust": "node scripts/tauri.mjs check",
    "test:rust": "node scripts/tauri.mjs test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "pdfjs-dist": "^5.4.394",
    "pdf-lib": "^1.17.1",
    "lucide-react": "^0.577.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "playwright": "^1.58.0"
  }
}
